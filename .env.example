# ─── ARIA Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.

# ── Required: at least one AI provider ──
OPENROUTER_API_KEY=        # https://openrouter.ai/keys
GROQ_API_KEY=              # https://console.groq.com/keys

# ── Optional: additional AI providers ──
CLOUDFLARE_ACCOUNT_ID=     # Cloudflare dashboard → Workers & Pages
CLOUDFLARE_AI_API=         # Cloudflare AI API token
DEEPSEEK_KEY=              # https://platform.deepseek.com
NEMOTRON_NVIDIA=           # https://integrate.api.nvidia.com
OPENAI_KEY=                # https://platform.openai.com (for DALL-E)

# ── Optional: local model servers ──
# Only reachable when ARIA runs on the same network. On Render, run
# aria-ollama-hook.js on your PC instead (it reads OLLAMA_URL too).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=

# ── Optional: tools ──
NEWSDATA_KEY=              # https://newsdata.io
SERPAPI_KEY=               # https://serpapi.com — used by ACTION: research and
                           # /research. Optional: without it, research falls back
                           # to DuckDuckGo's HTML endpoint and then Wikipedia,
                           # which work keyless but DuckDuckGo throttles under
                           # repeated queries.

# ── Optional: Google Calendar integration ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Optional: TTS ──
CUSTOM_VOICE=              # ElevenLabs voice ID or similar

# ── Cloud persistence (Firestore) ────────────────────────────────
# Render's filesystem is EPHEMERAL — without this, data/ (memory, tasks,
# behaviour, chats) is wiped on every redeploy. Set this to the personal-suite
# service-account JSON (raw JSON on one line, or base64) to persist state to
# Firestore (collection: aria_state). Leave empty to run local-only.
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=
# NOTE: data/rag/vectors.json is intentionally NOT synced (too big for a
# Firestore doc; embeddings are nested arrays). RAG re-ingests as a cache.

# ── Cross-app context: GRIND + hardware-tracker (Firestore) ──────
# Set this to your canonical personal-suite Firebase UID (see MIGRATION.md §3
# — the GRIND UID) to let ARIA read your GRIND streak/skills and
# hardware-tracker inventory for context (see lib/life-context.js). Requires
# FIREBASE_SERVICE_ACCOUNT above. Leave empty to skip — chat works the same,
# just without that context block.
ARIA_OWNER_UID=

# ── Access control (lib/auth.js) — SET THESE ON RENDER ─────────
# The lock-screen PIN in public/js/lock.js is public, so it protects nothing.
# ARIA_ACCESS_KEY is what the server actually checks: type it on the lock
# screen and you get a 30-day session cookie. Every /api route needs it.
# Without it on a public deploy, Claw refuses relays (it would otherwise let
# anyone with the URL run commands on your PC).
ARIA_ACCESS_KEY=           # long random string, e.g. `openssl rand -hex 24`
# What relays send (claw-relay.js --key=…, screenshot watcher, ESP32
# RELAY_KEY). Separate so a leaked device key can't log into the UI.
# Falls back to ARIA_ACCESS_KEY if unset.
ARIA_RELAY_KEY=
# ARIA_INSECURE_CLAW=true  # re-enables Claw on a keyless public deploy. Don't.

# ── Phone number: aria-voice-hook.js (runs on YOUR PC, not Render) ──
# Text ARIA through a Google Voice number. The hook also needs ARIA_ACCESS_KEY
# (above, or --key=…) because it talks to /api/chat like the web UI does.
# Every conversation starts locked; text this password to unlock it. It sits
# in plain text in your phone's and Google Voice's message history, so make it
# its own thing, NOT your ARIA_ACCESS_KEY. 8+ characters.
ARIA_SMS_PASSWORD=
ARIA_SMS_IDLE_MIN=5        # minutes of quiet before it locks again
ARIA_SMS_ALLOW=            # optional: +15551234567,+1… — only these numbers can unlock

# ── Server ──
PORT=3000
RENDER_EXTERNAL_URL=       # Set automatically on Render

# ── Daily briefing ──────────────────────────────────────────────
BRIEFING_ENABLED=false     # Set to true to enable daily briefings
BRIEFING_HOUR=8            # Hour (0-23) to deliver briefing (server time)
